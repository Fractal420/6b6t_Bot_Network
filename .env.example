# Copy this file to .env and provide the account credentials.

FRACTAL_HOST=alt3.6b6t.org
FRACTAL_PORT=25565
FRACTAL_USERNAME=
FRACTAL_PASSWORD=
FRACTAL_AUTH=offline
FRACTAL_VERSION=1.21.11

# Local control API
FRACTAL_CONTROL_HOST=127.0.0.1
FRACTAL_CONTROL_PORT=37637
# A random token is written to .env on first run when this is empty.
FRACTAL_CONTROL_TOKEN=
# Required when intentionally binding the API off loopback.
# FRACTAL_CONTROL_EXPOSE=1

# Offline accounts on 6b6t walk two server portals (auth + lobby).
FRACTAL_SERVER_PORTALS=2
FRACTAL_PORTAL_RETRY_MS=60000
FRACTAL_RECONNECT_MS=8000
FRACTAL_VIEW_DISTANCE=6
