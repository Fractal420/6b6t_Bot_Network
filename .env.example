# Copy this file to .env and provide the account credentials.

# Minecraft server connection
MC_HOST=alt3.6b6t.org
MC_HOSTS=alt3.6b6t.org,alt.6b6t.org,alt4.6b6t.org,alt5.6b6t.org,alt2.6b6t.org
MC_PORT=25565
MC_USERNAME=
MC_PASSWORD=
# offline (default) or microsoft
MC_AUTH=offline
MC_VERSION=1.21.11
MC_VIEW_DISTANCE=6
# When MC_AUTH=microsoft, tokens are cached in ./auth_cache

# Local control API (HTTP/WebSocket dashboard + CLI)
CONTROL_HOST=127.0.0.1
CONTROL_PORT=37637
# A random token is written to .env on first run when this is empty.
CONTROL_TOKEN=
# Required when intentionally binding the API off loopback.
# CONTROL_EXPOSE=1

# Offline accounts on 6b6t walk two server portals (auth + lobby).
SERVER_PORTALS=2
PORTAL_RETRY_MS=60000

# Reconnect / anti-bot behaviour
RECONNECT_MS=8000
# Max exponential backoff (ms)
RECONNECT_MAX_MS=300000
# Floor delay after "logging in too fast" / rate-limit kicks
RATE_LIMIT_COOLDOWN_MS=45000
# Cooldown after captcha / anti-bot kick (ms). Set to 0 to stop reconnecting
# until you manually restart the bot after solving the captcha.
CAPTCHA_COOLDOWN_MS=3600000

# Elytra mapper → Xaero World Map regions under MAP_OUTPUT_DIR
MAP_OUTPUT_DIR=./output
MAP_MODE=box
MAP_HOME_NAME=spawn
MAP_BOX_X1=20000
MAP_BOX_Z1=20000
MAP_BOX_X2=24000
MAP_BOX_Z2=24000
# 1 = auto-start mapping 8s after reaching main world
MAP_AUTO_START=0

# Discord remote control (optional — npm install discord.js)
DISCORD_ENABLED=0
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_MIRROR_LOGS=1


